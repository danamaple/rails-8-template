<h1>
  Promotion product #<%= @the_promotion_product.id %> details
</h1>

<article>
  <div>
    <a href="/promotion_products">
      Go back
    </a>
  </div>

  <div>
    <a href="/delete_promotion_product/<%= @the_promotion_product.id %>">
      Delete promotion product
    </a>
  </div>
  <dl>
    <dt>
      Promotion
    </dt>
    <dd>
      <%= @the_promotion_product.promotion_id %>
    </dd>

    <dt>
      Product
    </dt>
    <dd>
      <%= @the_promotion_product.product_id %>
    </dd>

    <dt>
      Created at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_promotion_product.created_at) %> ago
    </dd>

    <dt>
      Updated at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_promotion_product.updated_at) %> ago
    </dd>
  </dl>
</article>

<hr>


<article>
  <header>
    <h2>
      Edit promotion product
    </h2>
  </header>

  <form action="/modify_promotion_product/<%= @the_promotion_product.id %>"  method="post" >
    <div>
      <label for="promotion_id_box">
        Promotion
      </label>

      <input type="text" id="promotion_id_box" name="query_promotion_id" value="<%= @the_promotion_product.promotion_id %>">
    </div>

    <div>
      <label for="product_id_box">
        Product
      </label>

      <input type="text" id="product_id_box" name="query_product_id" value="<%= @the_promotion_product.product_id %>">
    </div>

    <button type="submit">
      Update promotion product
    </button>
  </form>
</article>

<hr>
