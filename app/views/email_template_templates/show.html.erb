<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/email_templates">Email Templates</a></li>
    <li><%= @the_email_template.name %></li>
  </ul>
</nav>

<article>
  <header>
    <%= @the_email_template.name %>
  </header>

  <dl>
    <dt>Subject</dt>
    <dd><%= @the_email_template.subject %></dd>

    <dt>Body</dt>
    <dd><div style="border: 1px solid #ddd; padding: 16px; border-radius: 8px;"><%= raw @the_email_template.body %></div></dd>

    <dt>Created</dt>
    <dd><%= time_ago_in_words(@the_email_template.created_at) %> ago</dd>
  </dl>

  <a href="/delete_email_template/<%= @the_email_template.id %>">Delete template</a>
</article>

<article>
  <header>
    Edit Template
  </header>

  <form action="/modify_email_template/<%= @the_email_template.id %>" method="post">
    <div>
      <label for="name_box">Name</label>
      <input type="text" id="name_box" name="query_name" value="<%= @the_email_template.name %>">
    </div>

    <div>
      <label for="subject_box">Subject</label>
      <input type="text" id="subject_box" name="query_subject" value="<%= @the_email_template.subject %>">
    </div>

    <div>
      <label for="body_box">Body</label>
      <p><small>Available merge fields: <code>{{company_name}}</code>, <code>{{first_name}}</code>, <code>{{last_name}}</code>, <code>{{title}}</code>, <code>{{rep_first_name}}</code>, <code>{{rep_last_name}}</code></small></p>
      <textarea id="body_box" name="query_body" rows="10"><%= @the_email_template.body %></textarea>
    </div>

    <div>
      <label>
        <input type="checkbox" name="query_show_prices" value="true" <%= @the_email_template.show_prices? ? "checked" : "" %> onchange="this.form.submit()">
        Show prices in email
      </label>
    </div>

    <button type="submit">Update Template</button>
  </form>
</article>

<article>
  <header>
    Products
  </header>

  <% if @template_products.any? %>
    <div class="overflow-auto">
      <table>
        <thead>
          <tr>
            <th>Position</th>
            <th>Name</th>
            <th>Brand</th>
            <th>Size</th>
            <th>Retail Price</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @template_products.each do |etp| %>
            <tr>
              <td><%= etp.position %></td>
              <td><a href="/products/<%= etp.product.id %>"><%= etp.product.name %></a></td>
              <td><%= etp.product.brand&.name %></td>
              <td><%= etp.product.size %></td>
              <td><%= etp.product.retail_price.present? ? "$#{"%.2f" % etp.product.retail_price}" : "" %></td>
              <td><a href="/delete_email_template_product/<%= etp.id %>">Remove</a></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>No products added yet.</p>
  <% end %>

  <hr>

  <strong>Add a product</strong>

  <form action="/insert_email_template_product" method="post">
    <input type="hidden" name="query_email_template_id" value="<%= @the_email_template.id %>">

    <div>
      <label for="product_id_box">Product</label>
      <select id="product_id_box" name="query_product_id">
        <option value="">-- select a product --</option>
        <% @list_of_all_products.each do |a_product| %>
          <option value="<%= a_product.id %>"><%= a_product.name %><%= a_product.brand.present? ? " — #{a_product.brand.name}" : "" %><%= a_product.size.present? ? " (#{a_product.size})" : "" %></option>
        <% end %>
      </select>
    </div>

    <button type="submit">Add Product</button>
  </form>
</article>

<article>
  <header>
    Product Rules
  </header>

  <p><small><%= @rule_matched_count %> product<%= @rule_matched_count == 1 ? "" : "s" %> match these rules</small></p>

  <% if @product_rules.any? %>
    <div class="overflow-auto">
      <table>
        <thead>
          <tr>
            <th>Field</th>
            <th>Measurement</th>
            <th>Value</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @product_rules.each do |rule| %>
            <tr>
              <td><%= rule.field %></td>
              <td><%= rule.measurement %></td>
              <td><%= rule.value %></td>
              <td><a href="/delete_email_product_rule/<%= rule.id %>">Remove</a></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>No rules added yet.</p>
  <% end %>

  <hr>

  <strong>Add a rule</strong>

  <form action="/insert_email_product_rule" method="post" id="product-rule-form">
    <input type="hidden" name="query_email_template_id" value="<%= @the_email_template.id %>">

    <div>
      <label for="rule_field_box">Field</label>
      <select id="rule_field_box" name="query_field" onchange="updateRuleValueInput(this.value)">
        <option value="">-- select a field --</option>
        <option value="new_arrival">new_arrival</option>
        <option value="product_category_one">product_category_one</option>
        <option value="product_category_two">product_category_two</option>
        <option value="brand">brand</option>
        <option value="supplier">supplier</option>
        <option value="name_contains">name_contains</option>
        <option value="retail_price_less_than">retail_price_less_than</option>
        <option value="retail_price_greater_than">retail_price_greater_than</option>
        <option value="added_within_days">added_within_days</option>
      </select>
    </div>

    <div>
      <label for="rule_measurement_box">Measurement</label>
      <input type="text" id="rule_measurement_box" name="query_measurement" value="equals" readonly>
    </div>

    <div id="rule_value_container">
      <label for="rule_value_box">Value</label>
      <input type="text" id="rule_value_box" name="query_value">
    </div>

    <button type="submit">Add Rule</button>
  </form>
</article>

<script>
var brandOptions = [<%= @list_of_brands.map { |b| "['#{b.id}', '#{b.name.gsub("'", "\\\\'")}']" }.join(", ").html_safe %>];
var supplierOptions = [<%= @list_of_suppliers.map { |s| "['#{s.id}', '#{s.name.gsub("'", "\\\\'")}']" }.join(", ").html_safe %>];
var catOneOptions = [<%= @list_of_category_ones.map { |c| "['#{c.name.gsub("'", "\\\\'")}', '#{c.name.gsub("'", "\\\\'")}']" }.join(", ").html_safe %>];
var catTwoOptions = [<%= @list_of_category_twos.map { |c| "['#{c.name.gsub("'", "\\\\'")}', '#{c.name.gsub("'", "\\\\'")}']" }.join(", ").html_safe %>];

function updateRuleValueInput(field) {
  var container = document.getElementById('rule_value_container');
  var measurement = document.getElementById('rule_measurement_box');

  var label = document.createElement('label');
  label.setAttribute('for', 'rule_value_box');
  label.textContent = 'Value';

  var input;

  if (field === 'new_arrival') {
    measurement.value = 'equals';
    input = document.createElement('select');
    input.name = 'query_value';
    input.id = 'rule_value_box';
    input.innerHTML = '<option value="true">true</option><option value="false">false</option>';
  } else if (field === 'brand') {
    measurement.value = 'equals';
    input = document.createElement('select');
    input.name = 'query_value';
    input.id = 'rule_value_box';
    input.innerHTML = '<option value="">-- select brand --</option>' +
      brandOptions.map(function(o) { return '<option value="' + o[1] + '">' + o[1] + '</option>'; }).join('');
  } else if (field === 'supplier') {
    measurement.value = 'equals';
    input = document.createElement('select');
    input.name = 'query_value';
    input.id = 'rule_value_box';
    input.innerHTML = '<option value="">-- select supplier --</option>' +
      supplierOptions.map(function(o) { return '<option value="' + o[1] + '">' + o[1] + '</option>'; }).join('');
  } else if (field === 'product_category_one') {
    measurement.value = 'equals';
    input = document.createElement('select');
    input.name = 'query_value';
    input.id = 'rule_value_box';
    input.innerHTML = '<option value="">-- select category --</option>' +
      catOneOptions.map(function(o) { return '<option value="' + o[1] + '">' + o[1] + '</option>'; }).join('');
  } else if (field === 'product_category_two') {
    measurement.value = 'equals';
    input = document.createElement('select');
    input.name = 'query_value';
    input.id = 'rule_value_box';
    input.innerHTML = '<option value="">-- select category --</option>' +
      catTwoOptions.map(function(o) { return '<option value="' + o[1] + '">' + o[1] + '</option>'; }).join('');
  } else if (field === 'retail_price_less_than') {
    measurement.value = 'less_than';
    input = document.createElement('input');
    input.type = 'number';
    input.step = '0.01';
    input.name = 'query_value';
    input.id = 'rule_value_box';
  } else if (field === 'retail_price_greater_than') {
    measurement.value = 'greater_than';
    input = document.createElement('input');
    input.type = 'number';
    input.step = '0.01';
    input.name = 'query_value';
    input.id = 'rule_value_box';
  } else if (field === 'added_within_days') {
    measurement.value = 'days';
    input = document.createElement('input');
    input.type = 'number';
    input.name = 'query_value';
    input.id = 'rule_value_box';
    label.textContent = 'Days';
  } else {
    measurement.value = 'equals';
    input = document.createElement('input');
    input.type = 'text';
    input.name = 'query_value';
    input.id = 'rule_value_box';
  }

  container.innerHTML = '';
  container.appendChild(label);
  container.appendChild(input);
}
</script>

<article>
  <header>
    Preview
  </header>

  <form action="/email_templates/<%= @the_email_template.id %>" method="get">
    <div>
      <label for="preview_contact_box">Preview for contact</label>
      <select id="preview_contact_box" name="preview_contact_id">
        <option value="">-- select a contact --</option>
        <% @list_of_all_contacts.each do |a_contact| %>
          <option value="<%= a_contact.id %>" <%= params["preview_contact_id"].to_s == a_contact.id.to_s ? "selected" : "" %>>
            <%= a_contact.first_name %> <%= a_contact.last_name %> — <%= a_contact.company.company_name %>
          </option>
        <% end %>
      </select>
    </div>

    <button type="submit">Preview</button>
  </form>

  <% if @preview %>
    <hr>
    <dl>
      <dt>Subject</dt>
      <dd><%= @preview[:subject] %></dd>

      <dt>Body</dt>
      <dd><div style="border: 1px solid #ddd; padding: 16px; border-radius: 8px;"><%= raw @preview[:body] %></div></dd>
    </dl>
    <p><small>Previewing for: <%= @preview_contact.first_name %> <%= @preview_contact.last_name %></small></p>
  <% end %>
</article>
