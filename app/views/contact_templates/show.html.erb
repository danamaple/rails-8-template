<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/companies">Companies</a></li>
    <li><a href="/companies/<%= @the_contact.company.id %>"><%= @the_contact.company.company_name %></a></li>
    <li><%= @the_contact.first_name %> <%= @the_contact.last_name %></li>
  </ul>
</nav>

<article>
  <header>
    <%= @the_contact.first_name %> <%= @the_contact.last_name %>
    <% if @the_contact.preferred_name.present? %>
      (<%= @the_contact.preferred_name %>)
    <% end %>
  </header>

  <dl>
    <dt>Company</dt>
    <dd>
      <a href="/companies/<%= @the_contact.company.id %>">
        <%= @the_contact.company.company_name %>
      </a>
    </dd>

    <dt>Title</dt>
    <dd><%= @the_contact.title %></dd>

    <dt>Email</dt>
    <dd><%= @the_contact.email %></dd>

    <dt>Phone</dt>
    <dd><%= @the_contact.phone %></dd>

    <dt>LinkedIn</dt>
    <dd><%= @the_contact.linkedin %></dd>

    <dt>General company contact</dt>
    <dd><%= @the_contact.general_company_contact ? "Yes" : "No" %></dd>

    <dt>Notes</dt>
    <dd><%= @the_contact.notes %></dd>

    <dt>Created</dt>
    <dd><%= time_ago_in_words(@the_contact.created_at) %> ago</dd>
  </dl>

  <a href="/delete_contact/<%= @the_contact.id %>">Delete contact</a>
</article>

<article>
  <header>
    Edit contact
  </header>

  <form action="/modify_contact/<%= @the_contact.id %>" method="post">
    <div>
      <label for="first_name_box">First name</label>
      <input type="text" id="first_name_box" name="query_first_name" value="<%= @the_contact.first_name %>">
    </div>

    <div>
      <label for="last_name_box">Last name</label>
      <input type="text" id="last_name_box" name="query_last_name" value="<%= @the_contact.last_name %>">
    </div>

    <div>
      <label for="preferred_name_box">Preferred name</label>
      <input type="text" id="preferred_name_box" name="query_preferred_name" value="<%= @the_contact.preferred_name %>">
    </div>

    <div>
      <label for="title_box">Title</label>
      <input type="text" id="title_box" name="query_title" value="<%= @the_contact.title %>">
    </div>

    <div>
      <label for="email_box">Email</label>
      <input type="email" id="email_box" name="query_email" value="<%= @the_contact.email %>">
    </div>

    <div>
      <label for="phone_box">Phone</label>
      <input type="text" id="phone_box" name="query_phone" value="<%= @the_contact.phone %>">
    </div>

    <div>
      <label for="linkedin_box">LinkedIn</label>
      <input type="text" id="linkedin_box" name="query_linkedin" value="<%= @the_contact.linkedin %>">
    </div>

    <div>
      <label for="notes_box">Notes</label>
      <textarea id="notes_box" name="query_notes"><%= @the_contact.notes %></textarea>
    </div>

    <div>
      <label>
        <input type="checkbox" name="query_general_company_contact" value="true"
          <%= @the_contact.general_company_contact ? "checked" : "" %>>
        General company contact
      </label>
    </div>

    <input type="hidden" name="query_company_id" value="<%= @the_contact.company_id %>">

    <button type="submit">Update contact</button>
  </form>
</article>

<article>
  <header>
    Outreaches with <%= @the_contact.first_name %> <%= @the_contact.last_name %>
  </header>

  <% contact_outreaches = @the_contact.outreaches.order({ :outreach_datetime => :desc }) %>

  <% if contact_outreaches.any? %>
    <div class="overflow-auto">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Medium</th>
            <th>Rep</th>
            <th>Notes</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% contact_outreaches.each do |an_outreach| %>
            <tr>
              <td>
                <a href="/outreaches/<%= an_outreach.id %>">
                  <%= an_outreach.outreach_datetime&.strftime("%b %e, %Y %l:%M %p") %>
                </a>
              </td>
              <td><%= an_outreach.outreach_medium %></td>
              <td><%= an_outreach.rep.first_name %> <%= an_outreach.rep.last_name %></td>
              <td><%= an_outreach.notes %></td>
              <td><a href="/delete_outreach/<%= an_outreach.id %>">Delete</a></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>No outreaches recorded yet.</p>
  <% end %>

  <hr>

  <strong>Log an outreach</strong>

  <form action="/insert_outreach" method="post">
    <input type="hidden" name="query_contact_id" value="<%= @the_contact.id %>">

    <div>
      <label for="outreach_datetime_box">Date &amp; time</label>
      <input type="datetime-local" id="outreach_datetime_box" name="query_outreach_datetime">
    </div>

    <div>
      <label for="outreach_medium_box">Medium</label>
      <input type="text" id="outreach_medium_box" name="query_outreach_medium" placeholder="e.g. Email, Phone, LinkedIn">
    </div>

    <div>
      <label for="notes_box">Notes</label>
      <textarea id="notes_box" name="query_notes"></textarea>
    </div>

    <button type="submit">Log outreach</button>
  </form>
</article>
