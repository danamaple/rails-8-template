<h1>
  List exclusion #<%= @the_list_exclusion.id %> details
</h1>

<article>
  <div>
    <a href="/list_exclusions">
      Go back
    </a>
  </div>

  <div>
    <a href="/delete_list_exclusion/<%= @the_list_exclusion.id %>">
      Delete list exclusion
    </a>
  </div>
  <dl>
    <dt>
      List
    </dt>
    <dd>
      <%= @the_list_exclusion.list_id %>
    </dd>

    <dt>
      Company
    </dt>
    <dd>
      <%= @the_list_exclusion.company_id %>
    </dd>

    <dt>
      Created at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_list_exclusion.created_at) %> ago
    </dd>

    <dt>
      Updated at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_list_exclusion.updated_at) %> ago
    </dd>
  </dl>
</article>

<hr>


<article>
  <header>
    <h2>
      Edit list exclusion
    </h2>
  </header>

  <form action="/modify_list_exclusion/<%= @the_list_exclusion.id %>"  method="post" >
    <div>
      <label for="list_id_box">
        List
      </label>

      <input type="text" id="list_id_box" name="query_list_id" value="<%= @the_list_exclusion.list_id %>">
    </div>

    <div>
      <label for="company_id_box">
        Company
      </label>

      <input type="text" id="company_id_box" name="query_company_id" value="<%= @the_list_exclusion.company_id %>">
    </div>

    <button type="submit">
      Update list exclusion
    </button>
  </form>
</article>

<hr>
