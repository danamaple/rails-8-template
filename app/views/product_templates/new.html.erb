<div class="page-header">
  <div>
    <h1 class="page-title">New Product</h1>
  </div>
  <a href="/products" class="btn btn-ghost btn-sm">← Back to Products</a>
</div>

<form action="/insert_product" method="post">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start;">

    <%# LEFT COLUMN — Product form fields %>
    <div>
      <div class="card" style="margin-bottom:16px;">
        <div class="card-header"><h3 class="card-title">Basic Info</h3></div>
        <div class="card-body">
          <div class="form-group">
            <label class="form-label">Name</label>
            <input type="text" name="query_name" class="form-input" placeholder="Product name">
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="form-group">
              <label class="form-label">SKU</label>
              <input type="text" name="query_sku" class="form-input" placeholder="SKU-001">
            </div>
            <div class="form-group">
              <label class="form-label">UPC</label>
              <input type="text" name="query_upc" class="form-input">
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Frontend Name</label>
            <input type="text" name="query_frontend_name" class="form-input">
          </div>
          <div class="form-group">
            <label class="form-label">Description</label>
            <textarea name="query_description" class="form-input" rows="3"></textarea>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
            <div class="form-group">
              <label class="form-label">Flavour</label>
              <input type="text" name="query_flavour" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">Size</label>
              <input type="text" name="query_size" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">Weight</label>
              <input type="text" name="query_weight" class="form-input">
            </div>
          </div>
        </div>
      </div>

      <div class="card" style="margin-bottom:16px;">
        <div class="card-header"><h3 class="card-title">Pricing</h3></div>
        <div class="card-body">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="form-group">
              <label class="form-label">Supply Price</label>
              <input type="number" name="query_supply_price" class="form-input" step="0.01" placeholder="0.00">
            </div>
            <div class="form-group">
              <label class="form-label">Retail Price</label>
              <input type="number" name="query_retail_price" class="form-input" step="0.01" placeholder="0.00">
            </div>
          </div>
        </div>
      </div>

      <div class="card" style="margin-bottom:16px;">
        <div class="card-header"><h3 class="card-title">Inventory</h3></div>
        <div class="card-body">
          <div style="display:flex;gap:16px;align-items:center;margin-bottom:12px;">
            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
              <input type="checkbox" name="query_track_inventory" value="true"> Track inventory
            </label>
            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
              <input type="checkbox" name="query_is_active" value="true" checked> Active
            </label>
            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
              <input type="checkbox" name="query_new_arrival" value="true"> New arrival
            </label>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
            <div class="form-group">
              <label class="form-label">Inventory Level</label>
              <input type="number" name="query_inventory_level" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">Reorder Point</label>
              <input type="number" name="query_reorder_point" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">Reorder Qty</label>
              <input type="number" name="query_reorder_quantity" class="form-input">
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">New Arrival Date</label>
            <input type="date" name="query_new_arrival_date" class="form-input">
          </div>
        </div>
      </div>

      <div class="card" style="margin-bottom:16px;">
        <div class="card-header"><h3 class="card-title">Classification</h3></div>
        <div class="card-body">
          <div class="form-group">
            <label class="form-label">Brand</label>
            <select name="query_brand_id" class="form-input">
              <option value="">— None —</option>
              <% @brands.each do |b| %>
                <option value="<%= b.id %>"><%= b.name %></option>
              <% end %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Supplier</label>
            <select name="query_supplier_id" class="form-input">
              <option value="">— None —</option>
              <% @suppliers.each do |s| %>
                <option value="<%= s.id %>"><%= s.name %></option>
              <% end %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Category (Level 1)</label>
            <select name="query_product_category_one_id" class="form-input">
              <option value="">— None —</option>
              <% @category_ones.each do |c| %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% end %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Image URL</label>
            <input type="text" name="query_image_url" class="form-input" placeholder="https://...">
          </div>
          <div class="form-group">
            <label class="form-label">Product URL</label>
            <input type="text" name="query_product_url" class="form-input" placeholder="https://...">
          </div>
        </div>
      </div>

      <div style="display:flex;gap:8px;">
        <button type="submit" class="btn btn-primary">Save Product</button>
        <a href="/products" class="btn btn-ghost">Cancel</a>
      </div>
    </div>

    <%# RIGHT COLUMN — Save first message %>
    <div>
      <div class="card">
        <div class="card-body" style="text-align:center;padding:48px 24px;color:#64748b;">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:40px;height:40px;margin:0 auto 12px;display:block;color:#94a3b8;"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
          <p style="font-weight:500;color:#475569;margin-bottom:6px;">Save the product first</p>
          <p style="font-size:13px;">Pricing, custom fields, and promotions can be added after the product is created.</p>
        </div>
      </div>
    </div>

  </div>
</form>
