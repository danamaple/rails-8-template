<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/companies">Home</a></li>
    <li>Admin Import</li>
  </ul>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0">Import CSV</h2>
</div>

<article>
  <header>
    Select table and download a template
  </header>

  <div class="d-flex gap-3 align-items-end flex-wrap">
    <div>
      <label for="table_select">Table</label>
      <select id="table_select" name="table">
        <option value="companies">Companies</option>
        <option value="contacts">Contacts</option>
        <option value="outreaches">Outreaches</option>
        <option value="categories">Categories</option>
        <option value="lists">Lists</option>
      </select>
    </div>

    <div>
      <a id="template_link" href="/admin/template?table=companies" role="button" class="secondary">Download Template</a>
    </div>
  </div>

  <script>
    document.getElementById('table_select').addEventListener('change', function () {
      document.getElementById('template_link').href = '/admin/template?table=' + this.value;
    });
  </script>
</article>

<article>
  <header>
    Upload CSV file
  </header>

  <form action="/admin/import" method="post" enctype="multipart/form-data">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

    <div class="mb-2">
      <label for="upload_table">Table to import into</label>
      <select id="upload_table" name="table">
        <option value="companies">Companies</option>
        <option value="contacts">Contacts</option>
        <option value="outreaches">Outreaches</option>
        <option value="categories">Categories</option>
        <option value="lists">Lists</option>
      </select>
    </div>

    <div class="mb-2">
      <label for="csv_file">CSV file</label>
      <input type="file" id="csv_file" name="csv_file" accept=".csv">
    </div>

    <button type="submit">Import</button>
  </form>
</article>

<article>
  <header>Import notes</header>
  <ul>
    <li><strong>Companies:</strong> Columns — company_name, website, status, notes</li>
    <li><strong>Contacts:</strong> Use <code>company_name</code> (not company_id) — the company is looked up by name automatically.</li>
    <li><strong>Outreaches:</strong> Use <code>contact_email</code> to look up the contact and <code>rep_email</code> to look up the rep.</li>
    <li><strong>Categories:</strong> Columns — category</li>
    <li><strong>Lists:</strong> Columns — name, notes</li>
    <li>Rows with missing required fields are skipped and counted as errors.</li>
  </ul>
</article>
