<div class="page-header">
  <h1 class="page-title">Suppliers</h1>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start;">
  <div class="card">
    <div class="card-header"><h3 class="card-title">All Suppliers</h3></div>
    <table class="data-table">
      <thead>
        <tr><th>Name</th><th>Contact</th><th>Email</th><th>Phone</th><th></th></tr>
      </thead>
      <tbody>
        <% @list_of_suppliers.each do |s| %>
          <tr>
            <td style="font-weight:500;"><%= s.name %></td>
            <td><%= s.contact_name %></td>
            <td><%= s.email %></td>
            <td><%= s.phone %></td>
            <td style="text-align:right;">
              <a href="/delete_supplier/<%= s.id %>" class="btn btn-danger-ghost btn-sm" data-confirm="Delete supplier?">Delete</a>
            </td>
          </tr>
        <% end %>
        <% if @list_of_suppliers.empty? %>
          <tr><td colspan="5" style="text-align:center;color:#94a3b8;padding:24px;">No suppliers yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <div class="card-header"><h3 class="card-title">Add Supplier</h3></div>
    <div class="card-body">
      <form action="/insert_supplier" method="post">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div class="form-group">
          <label class="form-label">Company Name</label>
          <input type="text" name="query_name" class="form-input" required>
        </div>
        <div class="form-group">
          <label class="form-label">Contact Name</label>
          <input type="text" name="query_contact_name" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" name="query_email" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label">Phone</label>
          <input type="text" name="query_phone" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label">Website</label>
          <input type="text" name="query_website" class="form-input">
        </div>
        <button type="submit" class="btn btn-primary">Add Supplier</button>
      </form>
    </div>
  </div>
</div>
