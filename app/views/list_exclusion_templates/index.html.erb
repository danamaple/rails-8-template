<h1>
  List of all list exclusions
</h1>

<hr>

<article>
  <header>
    <h2>
      Add a new list exclusion
    </h2>
  </header>

  <form action="/insert_list_exclusion" method="post">
    <div>
      <label for="list_id_box">
        List
      </label>

      <input type="text" id="list_id_box" name="query_list_id">
    </div>

    <div>
      <label for="company_id_box">
        Company
      </label>

      <input type="text" id="company_id_box" name="query_company_id">
    </div>

    <button type="submit">
      Create list exclusion
    </button>
  </form>
</article>

<hr>

<article>
  <ul>
    <% @list_of_list_exclusions.each do |a_list_exclusion| %>
      <li>
        <a href="/list_exclusions/<%= a_list_exclusion.id %>">
          List exclusion #<%= a_list_exclusion.id %>
        </a>
      </li>
    <% end %>
  </ul>
</article>

<hr>
