<nav aria-label="breadcrumb">
  <ul>
    <li>Lists</li>
  </ul>
</nav>

<article>
  <header>
    Add a new list
  </header>

  <form action="/insert_list" method="post">
    <div>
      <label for="name_box">List name</label>
      <input type="text" id="name_box" name="query_name">
    </div>

    <div>
      <label for="notes_box">Notes</label>
      <input type="text" id="notes_box" name="query_notes">
    </div>

    <button type="submit">Create list</button>
  </form>
</article>

<div class="d-flex justify-content-end mb-2">
  <a href="/export_lists.csv" role="button" class="outline" style="width: auto; margin-bottom: 0; padding: 8px 16px;">Download CSV</a>
</div>

<article>
  <header>
    All lists
  </header>

  <ul>
    <% @list_of_lists.each do |a_list| %>
      <li>
        <a href="/lists/<%= a_list.id %>">
          <%= a_list.name %>
        </a>
        (<%= a_list.list_memberships_count || 0 %> <%= (a_list.list_memberships_count || 0) == 1 ? "company" : "companies" %>)
        <% if a_list.notes.present? %>
          &mdash; <%= a_list.notes %>
        <% end %>
      </li>
    <% end %>
  </ul>
</article>
