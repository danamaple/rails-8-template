<h1>
  Smart list rule #<%= @the_smart_list_rule.id %> details
</h1>

<article>
  <div>
    <a href="/smart_list_rules">
      Go back
    </a>
  </div>

  <div>
    <a href="/delete_smart_list_rule/<%= @the_smart_list_rule.id %>">
      Delete smart list rule
    </a>
  </div>
  <dl>
    <dt>
      List
    </dt>
    <dd>
      <%= @the_smart_list_rule.list_id %>
    </dd>

    <dt>
      Field
    </dt>
    <dd>
      <%= @the_smart_list_rule.field %>
    </dd>

    <dt>
      Measurement
    </dt>
    <dd>
      <%= @the_smart_list_rule.measurement %>
    </dd>

    <dt>
      Value
    </dt>
    <dd>
      <%= @the_smart_list_rule.value %>
    </dd>

    <dt>
      Created at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_smart_list_rule.created_at) %> ago
    </dd>

    <dt>
      Updated at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_smart_list_rule.updated_at) %> ago
    </dd>
  </dl>
</article>

<hr>


<article>
  <header>
    <h2>
      Edit smart list rule
    </h2>
  </header>

  <form action="/modify_smart_list_rule/<%= @the_smart_list_rule.id %>"  method="post" >
    <div>
      <label for="list_id_box">
        List
      </label>

      <input type="text" id="list_id_box" name="query_list_id" value="<%= @the_smart_list_rule.list_id %>">
    </div>

    <div>
      <label for="field_box">
        Field
      </label>

      <input type="text" id="field_box" name="query_field" value="<%= @the_smart_list_rule.field %>">
    </div>

    <div>
      <label for="measurement_box">
        Measurement
      </label>

      <input type="text" id="measurement_box" name="query_measurement" value="<%= @the_smart_list_rule.measurement %>">
    </div>

    <div>
      <label for="value_box">
        Value
      </label>

      <input type="text" id="value_box" name="query_value" value="<%= @the_smart_list_rule.value %>">
    </div>

    <button type="submit">
      Update smart list rule
    </button>
  </form>
</article>

<hr>
