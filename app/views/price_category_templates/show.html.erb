<h1>
  Price category #<%= @the_price_category.id %> details
</h1>

<article>
  <div>
    <a href="/price_categories">
      Go back
    </a>
  </div>

  <div>
    <a href="/delete_price_category/<%= @the_price_category.id %>">
      Delete price category
    </a>
  </div>
  <dl>
    <dt>
      Name
    </dt>
    <dd>
      <%= @the_price_category.name %>
    </dd>

    <dt>
      Created at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_price_category.created_at) %> ago
    </dd>

    <dt>
      Updated at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_price_category.updated_at) %> ago
    </dd>
  </dl>
</article>

<hr>


<article>
  <header>
    <h2>
      Edit price category
    </h2>
  </header>

  <form action="/modify_price_category/<%= @the_price_category.id %>"  method="post" >
    <div>
      <label for="name_box">
        Name
      </label>

      <input type="text" id="name_box" name="query_name" value="<%= @the_price_category.name %>">
    </div>

    <button type="submit">
      Update price category
    </button>
  </form>
</article>

<hr>
