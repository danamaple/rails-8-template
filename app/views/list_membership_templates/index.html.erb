<h1>
  List of all list memberships
</h1>

<hr>

<article>
  <header>
    <h2>
      Add a new list membership
    </h2>
  </header>

  <form action="/insert_list_membership" method="post">
    <div>
      <label for="company_id_box">
        Company
      </label>

      <input type="text" id="company_id_box" name="query_company_id">
    </div>

    <div>
      <label for="list_id_box">
        List
      </label>

      <input type="text" id="list_id_box" name="query_list_id">
    </div>

    <button type="submit">
      Create list membership
    </button>
  </form>
</article>

<hr>

<article>
  <ul>
    <% @list_of_list_memberships.each do |a_list_membership| %>
      <li>
        <a href="/list_memberships/<%= a_list_membership.id %>">
          List membership #<%= a_list_membership.id %>
        </a>
      </li>
    <% end %>
  </ul>
</article>

<hr>
