<div class="page-header">
  <h1 class="page-title">New Promotion</h1>
  <a href="/promotions" class="btn btn-ghost btn-sm">← Back</a>
</div>

<div style="max-width:600px;">
  <div class="card">
    <div class="card-header"><h3 class="card-title">Promotion Details</h3></div>
    <form action="/insert_promotion" method="post">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <div class="card-body">
        <div class="form-group">
          <label class="form-label">Name</label>
          <input type="text" name="query_name" class="form-input" placeholder="e.g. Summer Sale 2026" required>
        </div>
        <div class="form-group">
          <label class="form-label">Description</label>
          <textarea name="query_description" class="form-input" rows="2"></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Discount Type</label>
          <select name="query_discount_type" class="form-input" onchange="toggleDiscountFields(this.value)">
            <option value="percentage">Percentage off</option>
            <option value="fixed">Fixed amount off</option>
            <option value="price_override">Price override</option>
            <option value="bogo">Buy X Get Y</option>
          </select>
        </div>
        <div id="discount-value-field" class="form-group">
          <label class="form-label">Discount Value</label>
          <input type="number" name="query_discount_value" class="form-input" step="0.01" placeholder="0.00">
        </div>
        <div id="bogo-fields" style="display:none;">
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
            <div class="form-group">
              <label class="form-label">Buy Quantity</label>
              <input type="number" name="query_buy_quantity" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">Get Quantity</label>
              <input type="number" name="query_get_quantity" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">Discount %</label>
              <input type="number" name="query_discount_percent" class="form-input" step="0.01">
            </div>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Minimum Quantity</label>
          <input type="number" name="query_min_quantity" class="form-input" placeholder="0 = no minimum">
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div class="form-group">
            <label class="form-label">Start Date</label>
            <input type="date" name="query_start_date" class="form-input">
          </div>
          <div class="form-group">
            <label class="form-label">End Date</label>
            <input type="date" name="query_end_date" class="form-input">
          </div>
        </div>
      </div>
      <div class="card-footer">
        <button type="submit" class="btn btn-primary">Create Promotion</button>
        <a href="/promotions" class="btn btn-ghost" style="margin-left:8px;">Cancel</a>
      </div>
    </form>
  </div>
</div>

<script>
function toggleDiscountFields(type) {
  document.getElementById('discount-value-field').style.display = type === 'bogo' ? 'none' : 'block';
  document.getElementById('bogo-fields').style.display = type === 'bogo' ? 'block' : 'none';
}
</script>
