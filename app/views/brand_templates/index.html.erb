<div class="page-header">
  <h1 class="page-title">Brands</h1>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start;">
  <div class="card">
    <div class="card-header"><h3 class="card-title">All Brands</h3></div>
    <table class="data-table">
      <thead>
        <tr><th>Name</th><th>Products</th><th></th></tr>
      </thead>
      <tbody>
        <% @list_of_brands.each do |b| %>
          <tr>
            <td style="font-weight:500;"><%= b.name %></td>
            <td><%= b.products.count %></td>
            <td style="text-align:right;">
              <a href="/delete_brand/<%= b.id %>" class="btn btn-danger-ghost btn-sm" data-confirm="Delete brand?">Delete</a>
            </td>
          </tr>
        <% end %>
        <% if @list_of_brands.empty? %>
          <tr><td colspan="3" style="text-align:center;color:#94a3b8;padding:24px;">No brands yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <div class="card-header"><h3 class="card-title">Add Brand</h3></div>
    <div class="card-body">
      <form action="/insert_brand" method="post">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div class="form-group">
          <label class="form-label">Name</label>
          <input type="text" name="query_name" class="form-input" placeholder="Brand name" required>
        </div>
        <button type="submit" class="btn btn-primary">Add Brand</button>
      </form>
    </div>
  </div>
</div>
