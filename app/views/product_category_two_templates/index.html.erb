<h1>
  List of all product category twos
</h1>

<hr>

<article>
  <header>
    <h2>
      Add a new product category two
    </h2>
  </header>

  <form action="/insert_product_category_two" method="post">
    <div>
      <label for="name_box">
        Name
      </label>

      <input type="text" id="name_box" name="query_name">
    </div>

    <div>
      <label for="product_category_one_id_box">
        Product category one
      </label>

      <input type="text" id="product_category_one_id_box" name="query_product_category_one_id">
    </div>

    <button type="submit">
      Create product category two
    </button>
  </form>
</article>

<hr>

<article>
  <ul>
    <% @list_of_product_category_twos.each do |a_product_category_two| %>
      <li>
        <a href="/product_category_twos/<%= a_product_category_two.id %>">
          Product category two #<%= a_product_category_two.id %>
        </a>
      </li>
    <% end %>
  </ul>
</article>

<hr>
