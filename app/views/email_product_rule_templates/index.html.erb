<h1>
  List of all email product rules
</h1>

<hr>

<article>
  <header>
    <h2>
      Add a new email product rule
    </h2>
  </header>

  <form action="/insert_email_product_rule" method="post">
    <div>
      <label for="email_template_id_box">
        Email template
      </label>

      <input type="text" id="email_template_id_box" name="query_email_template_id">
    </div>

    <div>
      <label for="field_box">
        Field
      </label>

      <input type="text" id="field_box" name="query_field">
    </div>

    <div>
      <label for="measurement_box">
        Measurement
      </label>

      <input type="text" id="measurement_box" name="query_measurement">
    </div>

    <div>
      <label for="value_box">
        Value
      </label>

      <input type="text" id="value_box" name="query_value">
    </div>

    <button type="submit">
      Create email product rule
    </button>
  </form>
</article>

<hr>

<article>
  <ul>
    <% @list_of_email_product_rules.each do |an_email_product_rule| %>
      <li>
        <a href="/email_product_rules/<%= an_email_product_rule.id %>">
          Email product rule #<%= an_email_product_rule.id %>
        </a>
      </li>
    <% end %>
  </ul>
</article>

<hr>
