<nav aria-label="breadcrumb">
  <ul>
    <li>Contacts</li>
  </ul>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0">Contacts</h2>
  <a href="/contacts/new" role="button">Add New Contact</a>
</div>

<article>
  <header>
    Filter contacts
  </header>

  <form action="/contacts" method="get">
    <div class="d-flex gap-2 flex-wrap align-items-end">
      <div>
        <label for="search_box">Search</label>
        <input type="text" id="search_box" name="query_search" value="<%= params["query_search"] %>" placeholder="Name or email...">
      </div>

      <div>
        <label for="company_filter">Company</label>
        <select id="company_filter" name="query_company_id">
          <option value="">All companies</option>
          <% @list_of_companies.each do |a_company| %>
            <option value="<%= a_company.id %>" <%= params["query_company_id"] == a_company.id.to_s ? "selected" : "" %>>
              <%= a_company.company_name %>
            </option>
          <% end %>
        </select>
      </div>

      <div>
        <label for="gcc_filter">General contact</label>
        <select id="gcc_filter" name="query_general_company_contact">
          <option value="">Any</option>
          <option value="true"  <%= params["query_general_company_contact"] == "true"  ? "selected" : "" %>>Yes</option>
          <option value="false" <%= params["query_general_company_contact"] == "false" ? "selected" : "" %>>No</option>
        </select>
      </div>

    </div>

    <div style="display: flex; align-items: center; gap: 8px; margin-top: 10px;">
      <button type="submit" style="width: auto; margin-bottom: 0; padding: 8px 16px;">Filter</button>
      <a href="/contacts" role="button" class="secondary" style="width: auto; margin-bottom: 0; padding: 8px 16px;">Clear</a>
      <a href="/export_contacts.csv<%= request.query_string.present? ? "?#{request.query_string}" : "" %>" role="button" class="outline" style="width: auto; margin-bottom: 0; padding: 8px 16px;">Download CSV</a>
    </div>
  </form>

  <p class="mt-2">
    <small>Showing <%= number_with_delimiter(@filtered_count) %> of <%= number_with_delimiter(@total_count) %> contacts</small>
  </p>
</article>

<article>
  <header>
    All contacts
  </header>

  <div class="overflow-auto">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Company</th>
          <th>Title</th>
          <th>Email</th>
          <th>Phone</th>
        </tr>
      </thead>
      <tbody>
        <% @list_of_contacts.each do |a_contact| %>
          <tr>
            <td>
              <a href="/contacts/<%= a_contact.id %>">
                <% if a_contact.first_name.present? || a_contact.last_name.present? %>
                  <%= a_contact.first_name %> <%= a_contact.last_name %>
                  <% if a_contact.preferred_name.present? %>(<%= a_contact.preferred_name %>)<% end %>
                <% else %>
                  <em><%= a_contact.title.present? ? a_contact.title : "General Contact" %></em>
                <% end %>
              </a>
            </td>
            <td>
              <a href="/companies/<%= a_contact.company.id %>">
                <%= a_contact.company.company_name %>
              </a>
            </td>
            <td><%= a_contact.title %></td>
            <td><%= a_contact.email %></td>
            <td style="white-space: nowrap; min-width: 130px;"><%= a_contact.phone %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</article>
