<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/companies">Home</a></li>
    <li>Admin Import</li>
  </ul>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0">Import CSV</h2>
</div>

<article>
  <header>
    Select table and download a template
  </header>

<div style="display: flex; align-items: end; gap: 12px;">
  <div>
    <label for="table_select">Table</label>
    <select id="table_select" name="table" style="margin-bottom: 0;">
      <option value="companies">Companies</option>
      <option value="contacts">Contacts</option>
      <option value="outreaches">Outreaches</option>
      <option value="categories">Categories</option>
      <option value="lists">Lists</option>
    </select>
  </div>

  <div>
    <a id="template_link" href="/admin/template?table=companies" role="button" class="secondary" style="margin-bottom: 0; padding: 16px 16px;">Download Template</a>
  </div>
</div>

  <script>
    document.getElementById('table_select').addEventListener('change', function () {
      document.getElementById('template_link').href = '/admin/template?table=' + this.value;
    });
  </script>
</article>

<article>
  <header>
    Upload CSV file
  </header>

  <form action="/admin/import" method="post" enctype="multipart/form-data">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

    <div class="mb-2">
      <label for="upload_table">Table to import into</label>
      <select id="upload_table" name="table">
        <option value="companies">Companies</option>
        <option value="contacts">Contacts</option>
        <option value="outreaches">Outreaches</option>
        <option value="categories">Categories</option>
        <option value="lists">Lists</option>
      </select>
    </div>

    <div class="mb-2">
      <label for="csv_file">CSV file</label>
      <input type="file" id="csv_file" name="csv_file" accept=".csv">
    </div>

    <button type="submit">Import</button>
  </form>
</article>

<article>
  <header>
    Clear database tables
  </header>

  <form action="/admin/purge" method="post" onsubmit="return confirmPurge(this)">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

    <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px;">
      <label>
        <input type="checkbox" name="tables[]" value="outreaches">
        Outreaches
      </label>
      <label>
        <input type="checkbox" name="tables[]" value="contacts">
        Contacts
      </label>
      <label>
        <input type="checkbox" name="tables[]" value="companies">
        Companies
      </label>
      <label>
        <input type="checkbox" name="tables[]" value="categories">
        Categories
      </label>
      <label>
        <input type="checkbox" name="tables[]" value="lists">
        Lists
      </label>
    </div>

    <button type="submit" class="secondary">Clear selected tables</button>
  </form>
</article>

<script>
  function confirmPurge(form) {
    var checked = Array.from(form.querySelectorAll('input[type="checkbox"]:checked'))
                       .map(function(cb) { return cb.value; });
    if (checked.length === 0) {
      alert("Please select at least one table to clear.");
      return false;
    }
    var names = checked.map(function(v) { return v.charAt(0).toUpperCase() + v.slice(1); }).join(", ");
    return confirm("Are you sure you want to permanently delete all records in: " + names + "?\n\nThis cannot be undone.");
  }
</script>
