<nav aria-label="breadcrumb">
  <ul>
    <li>Companies</li>
  </ul>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0">Companies</h2>
  <a href="/companies/new" role="button">Add New Company</a>
</div>

<article>
  <header>
    Filter companies
  </header>

  <form action="/companies" method="get">
    <div class="d-flex gap-2 flex-wrap align-items-end">
      <div>
        <label for="search_box">Search</label>
        <input type="text" id="search_box" name="query_search" value="<%= params["query_search"] %>" placeholder="Company name...">
      </div>

      <div>
        <label for="status_filter">Status</label>
        <select id="status_filter" name="query_status">
          <option value="">All statuses</option>
          <option value="Cold"           <%= params["query_status"] == "Cold"           ? "selected" : "" %>>Cold</option>
          <option value="Approaching"    <%= params["query_status"] == "Approaching"    ? "selected" : "" %>>Approaching</option>
          <option value="Warm"           <%= params["query_status"] == "Warm"           ? "selected" : "" %>>Warm</option>
          <option value="Converted"      <%= params["query_status"] == "Converted"      ? "selected" : "" %>>Converted</option>
          <option value="Do Not Contact" <%= params["query_status"] == "Do Not Contact" ? "selected" : "" %>>Do Not Contact</option>
        </select>
      </div>

      <div>
        <label for="category_filter">Category</label>
        <select id="category_filter" name="query_category_id">
          <option value="">All categories</option>
          <% @list_of_categories.each do |a_category| %>
            <option value="<%= a_category.id %>" <%= params["query_category_id"] == a_category.id.to_s ? "selected" : "" %>>
              <%= a_category.category %>
            </option>
          <% end %>
        </select>
      </div>

      <div>
        <label for="list_filter">List</label>
        <select id="list_filter" name="query_list_id">
          <option value="">All lists</option>
          <% @list_of_lists.each do |a_list| %>
            <option value="<%= a_list.id %>" <%= params["query_list_id"] == a_list.id.to_s ? "selected" : "" %>>
              <%= a_list.name %>
            </option>
          <% end %>
        </select>
      </div>

      <div>
        <label for="price_category_filter">Price Category</label>
        <select id="price_category_filter" name="query_price_category_id">
          <option value="">All price categories</option>
          <% @list_of_price_categories.each do |a_price_category| %>
            <option value="<%= a_price_category.id %>" <%= params["query_price_category_id"] == a_price_category.id.to_s ? "selected" : "" %>>
              <%= a_price_category.name %>
            </option>
          <% end %>
        </select>
      </div>
    </div>

    <div style="display: flex; align-items: center; gap: 8px; margin-top: 10px;">
      <button type="submit" style="width: auto; margin-bottom: 0; padding: 8px 16px;">Filter</button>
      <a href="/companies" role="button" class="secondary" style="width: auto; margin-bottom: 0; padding: 8px 16px;">Clear</a>
      <a href="/export_companies.csv<%= request.query_string.present? ? "?#{request.query_string}" : "" %>" role="button" class="outline" style="width: auto; margin-bottom: 0; padding: 8px 16px;">Download CSV</a>
    </div>
  </form>

  <p class="mt-2">
    <small>Showing <%= number_with_delimiter(@filtered_count) %> of <%= number_with_delimiter(@total_count) %> companies</small>
  </p>
</article>

<article>
  <header>
    All companies
  </header>

  <div class="overflow-auto">
    <table>
      <thead>
        <tr>
          <th>Company</th>
          <th>Status</th>
          <th>Website</th>
          <th>Categories</th>
          <th>Lists</th>
          <th>Calls</th>
          <th>Emails</th>
          <th>Letters</th>
          <th>Total Outreaches</th>
          <th>Emails Sent</th>
          <th>Most Recent</th>
          <th>Recent Owner</th>
          <th>Recent Format</th>
        </tr>
      </thead>
      <tbody>
        <% @list_of_companies.each do |a_company| %>
          <% stats  = @outreach_stats[a_company.id] %>
          <% recent = @recent_outreaches[a_company.id] %>
          <tr>
            <td>
              <a href="/companies/<%= a_company.id %>">
                <%= a_company.company_name %>
              </a>
            </td>
            <td><%= a_company.status %></td>
            <td style="max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
              <% url = a_company.website %>
              <% if url.present? %>
                <% url = "https://#{url}" unless url.start_with?("http://", "https://") %>
                <a href="<%= url %>" target="_blank" title="<%= a_company.website %>"><%= a_company.website %></a>
              <% end %>
            </td>
            <td><%= a_company.portfolios.map { |p| p.category.category }.join(", ") %></td>
            <td><%= a_company.list_memberships.map { |m| m.list.name }.join(", ") %></td>
            <td><%= stats&.phone_count  || 0 %></td>
            <td><%= stats&.email_count  || 0 %></td>
            <td><%= stats&.letter_count || 0 %></td>
            <td><%= stats&.total_outreaches || 0 %></td>
            <td><%= @email_stats[a_company.id] || 0 %></td>
            <td><%= stats&.most_recent_date&.to_time&.strftime("%b %-d, %Y") %></td>
            <td><%= recent&.rep_name %></td>
            <td><%= recent&.recent_medium %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</article>
