<div class="page-header">
  <div>
    <h1 class="page-title">Products</h1>
    <p class="page-subtitle"><%= @list_of_products.count %> products</p>
  </div>
  <div style="display:flex;gap:8px;align-items:center;">
    <a href="/export_products" class="btn btn-secondary btn-sm">Export CSV</a>
    <a href="/products/new" class="btn btn-primary">+ New Product</a>
  </div>
</div>

<div class="card" style="margin-bottom:16px;">
  <form action="/products" method="get" style="display:flex;gap:8px;padding:12px 16px;align-items:center;">
    <input type="text" name="q" value="<%= @q %>" placeholder="Search by name, SKU, UPC..." style="flex:1;" class="form-input">
    <button type="submit" class="btn btn-secondary btn-sm">Search</button>
    <% if @q.present? %>
      <a href="/products" class="btn btn-ghost btn-sm">Clear</a>
    <% end %>
  </form>
</div>

<div class="card">
  <table class="data-table">
    <thead>
      <tr>
        <th>SKU</th>
        <th>Name</th>
        <th>Brand</th>
        <th>Supply Price</th>
        <th>Retail Price</th>
        <th>Status</th>
        <th>Inventory</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @list_of_products.each do |p| %>
        <tr>
          <td><code style="font-size:12px;"><%= p.sku.presence || "—" %></code></td>
          <td>
            <a href="/products/<%= p.id %>" style="font-weight:500;"><%= p.name.presence || "Unnamed" %></a>
            <% if p.new_arrival? %>
              <span class="badge badge-blue" style="margin-left:6px;">New</span>
            <% end %>
          </td>
          <td><%= p.brand&.name || "—" %></td>
          <td><%= p.supply_price ? "$#{"%.2f" % p.supply_price}" : "—" %></td>
          <td><%= p.retail_price ? "$#{"%.2f" % p.retail_price}" : "—" %></td>
          <td>
            <% if p.is_active? %>
              <span class="badge badge-green">Active</span>
            <% else %>
              <span class="badge badge-gray">Inactive</span>
            <% end %>
          </td>
          <td>
            <% if p.track_inventory? %>
              <%= p.inventory_level || 0 %> units
            <% else %>
              —
            <% end %>
          </td>
          <td style="text-align:right;">
            <a href="/products/<%= p.id %>" class="btn btn-ghost btn-sm">View</a>
            <a href="/delete_product/<%= p.id %>" class="btn btn-danger-ghost btn-sm" data-confirm="Delete this product?">Delete</a>
          </td>
        </tr>
      <% end %>
      <% if @list_of_products.empty? %>
        <tr>
          <td colspan="8" style="text-align:center;color:#94a3b8;padding:32px;">No products found.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
