<nav aria-label="breadcrumb">
  <ul>
    <li>Contacts</li>
  </ul>
</nav>

<article>
  <header>
    Filter contacts
  </header>

  <form action="/contacts" method="get">
    <div class="d-flex gap-2 flex-wrap align-items-end">
      <div>
        <label for="search_box">Search</label>
        <input type="text" id="search_box" name="query_search" value="<%= params["query_search"] %>" placeholder="Name or email...">
      </div>

      <div>
        <label for="company_filter">Company</label>
        <select id="company_filter" name="query_company_id">
          <option value="">All companies</option>
          <% @list_of_companies.each do |a_company| %>
            <option value="<%= a_company.id %>" <%= params["query_company_id"] == a_company.id.to_s ? "selected" : "" %>>
              <%= a_company.company_name %>
            </option>
          <% end %>
        </select>
      </div>

      <div>
        <label for="gcc_filter">General contact</label>
        <select id="gcc_filter" name="query_general_company_contact">
          <option value="">Any</option>
          <option value="true"  <%= params["query_general_company_contact"] == "true"  ? "selected" : "" %>>Yes</option>
          <option value="false" <%= params["query_general_company_contact"] == "false" ? "selected" : "" %>>No</option>
        </select>
      </div>

      <div>
        <button type="submit">Filter</button>
      </div>

      <div>
        <a href="/contacts" role="button" class="secondary">Clear</a>
      </div>
    </div>
  </form>

  <p class="mt-2">
    <small>Showing <%= number_with_delimiter(@filtered_count) %> of <%= number_with_delimiter(@total_count) %> contacts</small>
  </p>
</article>

<article>
  <header>
    Add a new contact
  </header>

  <form action="/insert_contact" method="post">
    <div>
      <label for="company_id_box">Company</label>
      <select id="company_id_box" name="query_company_id">
        <option value="">-- select a company --</option>
        <% @list_of_companies.each do |a_company| %>
          <option value="<%= a_company.id %>"><%= a_company.company_name %></option>
        <% end %>
      </select>
    </div>

    <div>
      <label for="first_name_box">First name</label>
      <input type="text" id="first_name_box" name="query_first_name">
    </div>

    <div>
      <label for="last_name_box">Last name</label>
      <input type="text" id="last_name_box" name="query_last_name">
    </div>

    <div>
      <label for="preferred_name_box">Preferred name</label>
      <input type="text" id="preferred_name_box" name="query_preferred_name">
    </div>

    <div>
      <label for="title_box">Title</label>
      <input type="text" id="title_box" name="query_title">
    </div>

    <div>
      <label for="email_box">Email</label>
      <input type="email" id="email_box" name="query_email">
    </div>

    <div>
      <label for="phone_box">Phone</label>
      <input type="text" id="phone_box" name="query_phone">
    </div>

    <div>
      <label for="linkedin_box">LinkedIn</label>
      <input type="text" id="linkedin_box" name="query_linkedin">
    </div>

    <div>
      <label for="notes_box">Notes</label>
      <textarea id="notes_box" name="query_notes"></textarea>
    </div>

    <div>
      <label>
        <input type="checkbox" name="query_general_company_contact" value="true">
        General company contact
      </label>
    </div>

    <button type="submit">Create contact</button>
  </form>
</article>

<article>
  <header>
    All contacts
  </header>

  <div class="overflow-auto">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Company</th>
          <th>Title</th>
          <th>Email</th>
          <th>Phone</th>
        </tr>
      </thead>
      <tbody>
        <% @list_of_contacts.each do |a_contact| %>
          <tr>
            <td>
              <a href="/contacts/<%= a_contact.id %>">
                <%= a_contact.first_name %> <%= a_contact.last_name %>
                <% if a_contact.preferred_name.present? %>(<%= a_contact.preferred_name %>)<% end %>
              </a>
            </td>
            <td>
              <a href="/companies/<%= a_contact.company.id %>">
                <%= a_contact.company.company_name %>
              </a>
            </td>
            <td><%= a_contact.title %></td>
            <td><%= a_contact.email %></td>
            <td><%= a_contact.phone %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</article>
