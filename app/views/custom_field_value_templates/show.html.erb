<h1>
  Custom field value #<%= @the_custom_field_value.id %> details
</h1>

<article>
  <div>
    <a href="/custom_field_values">
      Go back
    </a>
  </div>

  <div>
    <a href="/delete_custom_field_value/<%= @the_custom_field_value.id %>">
      Delete custom field value
    </a>
  </div>
  <dl>
    <dt>
      Product
    </dt>
    <dd>
      <%= @the_custom_field_value.product_id %>
    </dd>

    <dt>
      Custom field
    </dt>
    <dd>
      <%= @the_custom_field_value.custom_field_id %>
    </dd>

    <dt>
      Value
    </dt>
    <dd>
      <%= @the_custom_field_value.value %>
    </dd>

    <dt>
      Created at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_custom_field_value.created_at) %> ago
    </dd>

    <dt>
      Updated at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_custom_field_value.updated_at) %> ago
    </dd>
  </dl>
</article>

<hr>


<article>
  <header>
    <h2>
      Edit custom field value
    </h2>
  </header>

  <form action="/modify_custom_field_value/<%= @the_custom_field_value.id %>"  method="post" >
    <div>
      <label for="product_id_box">
        Product
      </label>

      <input type="text" id="product_id_box" name="query_product_id" value="<%= @the_custom_field_value.product_id %>">
    </div>

    <div>
      <label for="custom_field_id_box">
        Custom field
      </label>

      <input type="text" id="custom_field_id_box" name="query_custom_field_id" value="<%= @the_custom_field_value.custom_field_id %>">
    </div>

    <div>
      <label for="value_box">
        Value
      </label>

      <input type="text" id="value_box" name="query_value" value="<%= @the_custom_field_value.value %>">
    </div>

    <button type="submit">
      Update custom field value
    </button>
  </form>
</article>

<hr>
